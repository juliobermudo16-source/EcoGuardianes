# EcoGuardianes - normalizacion de finales de linea
# Necesario para que el Gradle Wrapper funcione en los runners Linux de CI.

* text=auto eol=lf

# Scripts que deben conservar LF si o si
gradlew         text eol=lf
*.sh            text eol=lf

# Scripts de Windows
gradlew.bat     text eol=crlf
*.bat           text eol=crlf

# Binarios: git no debe tocarlos nunca
*.pdf           binary
*.png           binary
*.jpg           binary
*.jar           binary
*.apk           binary
*.zip           binary
*.keystore      binary
